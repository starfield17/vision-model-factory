{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-lab.local/schemas/data/task_spec.schema.json",
  "title": "TaskSpec",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "task_type",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "task_id": {"type": "string", "minLength": 1},
    "task_type": {"type": "string", "const": "object_detection"},
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class_id", "display_name", "prompt"],
        "additionalProperties": false,
        "properties": {
          "class_id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "prompt": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
