{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-lab.local/schemas/model/evaluation_report.schema.json",
  "title": "EvaluationReport",
  "description": "Independent evaluation evidence. val, locked test, export parity and target performance stay in separate sections and are never collapsed into one score.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "dataset",
    "test",
    "export_parity",
    "target_benchmarks",
    "gate"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "required": [
        "dataset_id",
        "manifest_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "test": {
      "$ref": "#/$defs/testSection"
    },
    "export_parity": {
      "$ref": "#/$defs/exportParitySection"
    },
    "target_benchmarks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetBenchmark"
      }
    },
    "gate": {
      "$ref": "#/$defs/gateSection"
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "inferenceConfig": {
      "type": "object",
      "required": [
        "score_threshold",
        "nms_iou_threshold",
        "max_detections",
        "target_shape"
      ],
      "additionalProperties": false,
      "properties": {
        "score_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "nms_iou_threshold": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "max_detections": {
          "type": "integer",
          "minimum": 1
        },
        "target_shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "perClassMetrics": {
      "type": "object",
      "required": [
        "class_id",
        "ap50",
        "ap50_95",
        "precision",
        "recall",
        "total_gt",
        "total_pred"
      ],
      "additionalProperties": false,
      "properties": {
        "class_id": {
          "type": "string",
          "minLength": 1
        },
        "ap50": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "ap50_95": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "precision": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "recall": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "total_gt": {
          "type": "integer",
          "minimum": 0
        },
        "total_pred": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "testSection": {
      "type": "object",
      "required": [
        "protocol_id",
        "ground_truth",
        "sample_count",
        "gt_annotation_count",
        "excluded_partial_count",
        "mAP50",
        "mAP50_95",
        "classes",
        "inference_config"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol_id": {
          "type": "string",
          "minLength": 1
        },
        "ground_truth": {
          "type": "string",
          "const": "human_verified"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "gt_annotation_count": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_partial_count": {
          "type": "integer",
          "minimum": 0
        },
        "mAP50": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "mAP50_95": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "classes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/perClassMetrics"
          }
        },
        "inference_config": {
          "$ref": "#/$defs/inferenceConfig"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "parityTolerances": {
      "type": "object",
      "required": [
        "tensor_atol",
        "score_atol",
        "box_atol"
      ],
      "additionalProperties": false,
      "properties": {
        "tensor_atol": {
          "type": "number",
          "minimum": 0.0
        },
        "score_atol": {
          "type": "number",
          "minimum": 0.0
        },
        "box_atol": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "parityTensor": {
      "type": "object",
      "required": [
        "max_abs_diff",
        "mean_abs_diff",
        "passed"
      ],
      "additionalProperties": false,
      "properties": {
        "max_abs_diff": {
          "type": "number",
          "minimum": 0.0
        },
        "mean_abs_diff": {
          "type": "number",
          "minimum": 0.0
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "parityDetections": {
      "type": "object",
      "required": [
        "ref_count",
        "ort_count",
        "matched",
        "max_score_diff",
        "max_box_diff"
      ],
      "additionalProperties": false,
      "properties": {
        "ref_count": {
          "type": "integer",
          "minimum": 0
        },
        "ort_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "boolean"
        },
        "max_score_diff": {
          "type": "number",
          "minimum": 0.0
        },
        "max_box_diff": {
          "type": "number",
          "minimum": 0.0
        }
      }
    },
    "exportParitySection": {
      "type": "object",
      "required": [
        "status",
        "method",
        "input_reference",
        "matching_method",
        "tolerances",
        "raw_tensor",
        "detections",
        "inference_config"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "input_reference": {
          "type": "string",
          "minLength": 1
        },
        "matching_method": {
          "type": "string",
          "minLength": 1
        },
        "tolerances": {
          "$ref": "#/$defs/parityTolerances"
        },
        "raw_tensor": {
          "$ref": "#/$defs/parityTensor"
        },
        "detections": {
          "$ref": "#/$defs/parityDetections"
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "inference_config": {
          "$ref": "#/$defs/inferenceConfig"
        },
        "extensions": {
          "type": "object"
        },
        "self_test": {
          "$ref": "#/$defs/paritySelfTest"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "self_test"
            ],
            "properties": {
              "raw_tensor": {
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              },
              "detections": {
                "required": [
                  "ref_count",
                  "ort_count",
                  "matched"
                ],
                "properties": {
                  "matched": {
                    "const": true
                  },
                  "ref_count": {
                    "minimum": 1
                  },
                  "ort_count": {
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      ],
      "description": "Export parity evidence. A 'passed' status is structurally impossible without non-empty detections on both sides and a self-test that detected the injected perturbation: an empty comparison verifies nothing about coordinate recovery."
    },
    "targetBenchmark": {
      "type": "object",
      "required": [
        "os_name",
        "os_version",
        "architecture",
        "device",
        "runtime",
        "runtime_version",
        "provider",
        "providers_used",
        "requested_providers",
        "warmup_runs",
        "benchmark_runs",
        "latency_ms_p50",
        "latency_ms_p95",
        "latency_ms_mean",
        "peak_memory_bytes",
        "input_reference",
        "inference_config"
      ],
      "additionalProperties": false,
      "properties": {
        "os_name": {
          "type": "string",
          "minLength": 1
        },
        "os_version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "providers_used": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requested_providers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "warmup_runs": {
          "type": "integer",
          "minimum": 0
        },
        "benchmark_runs": {
          "type": "integer",
          "minimum": 1
        },
        "latency_ms_p50": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "latency_ms_p95": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "latency_ms_mean": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "input_reference": {
          "type": "string",
          "minLength": 1
        },
        "inference_config": {
          "$ref": "#/$defs/inferenceConfig"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "gateCheck": {
      "type": "object",
      "required": [
        "metric",
        "threshold",
        "actual",
        "passed",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "number"
        },
        "actual": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        },
        "direction": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        },
        "class_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gateSection": {
      "type": "object",
      "required": [
        "policy_id",
        "policy_sha256",
        "status",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gateCheck"
          }
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "paritySelfTest": {
      "type": "object",
      "description": "Proof that the parity comparison can actually fail. Two empty detection lists match trivially, so a passed verdict must show that an injected coordinate perturbation was detected.",
      "required": [
        "perturbation_px",
        "detected_perturbation"
      ],
      "additionalProperties": false,
      "properties": {
        "perturbation_px": {
          "type": "number",
          "exclusiveMinimum": 0.0
        },
        "detected_perturbation": {
          "type": "boolean"
        }
      }
    }
  }
}
