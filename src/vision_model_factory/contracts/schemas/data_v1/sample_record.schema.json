{
  "$defs": {
    "FileRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "FileRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "file": {
      "$ref": "#/$defs/FileRef"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "group_id": {
      "minLength": 1,
      "title": "Group Id",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test",
        "audit"
      ],
      "title": "Split",
      "type": "string"
    },
    "annotation_status": {
      "enum": [
        "partial",
        "complete_pseudo",
        "complete_verified"
      ],
      "title": "Annotation Status",
      "type": "string"
    },
    "extensions": {
      "title": "Extensions",
      "additionalProperties": true,
      "type": "object"
    }
  },
  "required": [
    "sample_id",
    "file",
    "width",
    "height",
    "group_id",
    "split",
    "annotation_status"
  ],
  "title": "SampleRecord",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vision:data:1.0.0:sample_record"
}
