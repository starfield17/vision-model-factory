{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00-\\x1f]+$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "original_image",
            "overlay"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "FindingRecord": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "wrong_class",
            "missing_object",
            "bad_box",
            "duplicate",
            "ambiguous"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "annotation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Annotation Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "reason",
        "annotation_ids"
      ],
      "title": "FindingRecord",
      "type": "object"
    },
    "ReportExtensions": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "title": "Evidence",
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "type": "array"
        },
        "severity": {
          "title": "Severity",
          "enum": [
            "info",
            "warning",
            "error",
            "critical"
          ],
          "type": "string"
        }
      },
      "title": "ReportExtensions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "review_id": {
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "sample_id": {
      "minLength": 1,
      "title": "Sample Id",
      "type": "string"
    },
    "reviewer_run_id": {
      "minLength": 1,
      "title": "Reviewer Run Id",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "suspect",
        "abstain"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/FindingRecord"
      },
      "title": "Findings",
      "type": "array"
    },
    "extensions": {
      "$ref": "#/$defs/ReportExtensions"
    }
  },
  "required": [
    "review_id",
    "sample_id",
    "reviewer_run_id",
    "verdict",
    "findings"
  ],
  "title": "ReviewReport",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vision:data:1.0.0:review_report"
}
